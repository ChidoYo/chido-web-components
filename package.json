{
  "name": "@chidoyo/chido-web-components",
  "version": "0.1.0",
  "author": "Erick Adrian Perez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChidoYo/chido-web-components.git"
  },
  "bugs": {
    "url": "https://github.com/ChidoYo/chido-web-components/issues"
  },
  "description": "Framework-independent Web Components for forms and user interfaces, with TypeScript definitions, customizable themes, English and Spanish validation, and optional React wrappers.",
  "keywords": [
    "web-components",
    "custom-elements",
    "shadow-dom",
    "form-controls",
    "typescript",
    "localization",
    "theming",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "npm run generate:react && tsc && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && sass src/styles/themes.scss dist/package/themes.css --style=compressed --no-source-map",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "generate:react": "node scripts/generate-react.mjs",
    "check:generated": "node scripts/generate-react.mjs --check",
    "predev": "npm run generate:react",
    "prepack": "npm run build",
    "pretest": "npm run build && npm run test:types",
    "pretypecheck": "npm run generate:react",
    "test:types": "tsc -p tsconfig.react-tests.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "exports": {
    ".": {
      "types": "./dist/package/types/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./react": {
      "types": "./dist/package/types/react/index.d.ts",
      "import": "./dist/package/react.js"
    },
    "./themes.css": "./dist/package/themes.css"
  },
  "types": "./dist/package/types/index.d.ts",
  "files": [
    "dist/package",
    "README.md",
    "COMPONENTS.md",
    "REACT.md",
    "COMPONENT_GUIDE.md",
    "QUALITY.md"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
